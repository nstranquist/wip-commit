{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nstranquist/wip-commit/blob/main/docs/PLAN.schema.json",
  "title": "wip split commit plan",
  "type": "array",
  "minItems": 1,
  "maxItems": 128,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["message", "files"],
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "verify": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv"],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {"type": "string"}
            },
            "directory": {"type": "string"},
            "timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            }
          }
        }
      }
    }
  }
}
