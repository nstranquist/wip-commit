{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nstranquist/wip-commit/blob/main/docs/HANDOFF.schema.json",
  "title": "wip cumulative capture-only handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "handoff_digest",
    "capture_only",
    "landing_authorized",
    "review_eligible",
    "lane_ref",
    "lane_tip",
    "lane_base_commit",
    "final_tree",
    "tip_plan_id",
    "tip_capture_intent_digest",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "kind": {"const": "capture_handoff"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "capture_only": {"const": true},
    "landing_authorized": {"const": false},
    "review_eligible": {"type": "boolean"},
    "lane_ref": {"type": "string", "pattern": "^refs/heads/wip/[^/]+/[^/]+$"},
    "lane_tip": {"$ref": "#/$defs/object_id"},
    "lane_base_commit": {"$ref": "#/$defs/object_id"},
    "final_tree": {"$ref": "#/$defs/object_id"},
    "tip_plan_id": {"$ref": "#/$defs/plan_id"},
    "tip_capture_intent_digest": {"$ref": "#/$defs/digest"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_eligible": {"const": true}}, "required": ["review_eligible"]},
      "then": {
        "properties": {
          "segments": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/segment"},
                {
                  "required": [
                    "reviewed_plan_digest",
                    "message_policy",
                    "source_mode",
                    "untracked_policy",
                    "source_digest",
                    "source_paths"
                  ],
                  "properties": {"message_policy_bound": {"const": true}}
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{24}$"},
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "message_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"enum": ["conventional-v1", "safety-only-v1"]},
        "version": {"const": "1.0.0"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "plan_id",
        "capture_intent_digest",
        "message_policy_bound",
        "intent_state",
        "source_head",
        "parent_commit",
        "final_commit",
        "final_tree",
        "commits"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "plan_id": {"$ref": "#/$defs/plan_id"},
        "capture_intent_digest": {"$ref": "#/$defs/digest"},
        "reviewed_plan_digest": {"$ref": "#/$defs/digest"},
        "message_policy": {"$ref": "#/$defs/message_policy"},
        "message_policy_bound": {"type": "boolean"},
        "intent_state": {"const": "complete"},
        "source_head": {"$ref": "#/$defs/object_id"},
        "source_mode": {"enum": ["staged_index", "worktree_snapshot"]},
        "untracked_policy": {"enum": ["not_applicable", "forbid", "include"]},
        "source_digest": {"$ref": "#/$defs/digest"},
        "source_paths": {"$ref": "#/$defs/paths"},
        "parent_commit": {"$ref": "#/$defs/object_id"},
        "final_commit": {"$ref": "#/$defs/object_id"},
        "final_tree": {"$ref": "#/$defs/object_id"},
        "commits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/commit"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"message_policy_bound": {"const": true}}, "required": ["message_policy_bound"]},
          "then": {"required": ["reviewed_plan_digest", "message_policy"]}
        },
        {
          "if": {"properties": {"source_mode": {"const": "staged_index"}}, "required": ["source_mode"]},
          "then": {"properties": {"untracked_policy": {"const": "not_applicable"}}}
        },
        {
          "if": {"properties": {"source_mode": {"const": "worktree_snapshot"}}, "required": ["source_mode"]},
          "then": {"properties": {"untracked_policy": {"enum": ["forbid", "include"]}}}
        }
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "message", "parent", "commit", "tree", "changed_paths", "verify_count", "repairs_applied"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "message": {"type": "string", "minLength": 1},
        "parent": {"$ref": "#/$defs/object_id"},
        "commit": {"$ref": "#/$defs/object_id"},
        "tree": {"$ref": "#/$defs/object_id"},
        "changed_paths": {"$ref": "#/$defs/paths"},
        "verify_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "repairs_applied": {"type": "integer", "minimum": 0}
      }
    }
  }
}
